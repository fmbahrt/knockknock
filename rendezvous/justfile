# Go rendezvous server

bin := "../bin/rendezvous"

# Build the server binary into bin/
build:
    go build -o {{ bin }} ./cmd/rendezvous

# Run the server (writes its dev CA to bin/dev-ca.pem unless given -tls-cert/-tls-key)
run *args:
    go run ./cmd/rendezvous -tls-dev-ca ../bin/dev-ca.pem {{ args }}

# Run tests
test:
    go test -race ./...

# Vet and check formatting
lint:
    go vet ./...
    test -z "$(gofmt -l .)" || (gofmt -l . && echo "run: just fmt" && exit 1)

# Format code
fmt:
    gofmt -w .

# Remove build artifacts
clean:
    rm -f {{ bin }}
