[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://addons/knockknock/bin/libknockknock_godot.dylib"
macos.release = "res://addons/knockknock/bin/libknockknock_godot.dylib"
linux.debug.x86_64 = "res://addons/knockknock/bin/libknockknock_godot.so"
linux.release.x86_64 = "res://addons/knockknock/bin/libknockknock_godot.so"
linux.debug.arm64 = "res://addons/knockknock/bin/libknockknock_godot.so"
linux.release.arm64 = "res://addons/knockknock/bin/libknockknock_godot.so"
windows.debug.x86_64 = "res://addons/knockknock/bin/knockknock_godot.dll"
windows.release.x86_64 = "res://addons/knockknock/bin/knockknock_godot.dll"
